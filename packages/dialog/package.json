{
  "name": "@omnireact/dialog",
  "version": "0.0.1",
  "description": "Headless, imperative dialog API for React (alert/confirm/prompt + custom dialogs).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnireact/core": "workspace:*",
    "invariant": "^2.2.4"
  },
  "devDependencies": {
    "@types/invariant": "^2.2.37"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@lamstack/http-client",
  "version": "0.0.0",
  "description": "Framework-agnostic HTTP client core with a pluggable middleware pipeline — no hard dependency on axios or fetch.",
  "keywords": [
    "http",
    "fetch",
    "axios",
    "middleware",
    "headless",
    "lamstack"
  ],
  "license": "MIT",
  "author": "Ja Khang",
  "homepage": "https://omnireact-six.vercel.app/http",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakhang/lamstack.git",
    "directory": "packages/http"
  },
  "bugs": {
    "url": "https://github.com/jakhang/lamstack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "axios": "^1.7.9"
  },
  "publishConfig": {
    "access": "public"
  }
}

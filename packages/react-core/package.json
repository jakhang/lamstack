{
  "name": "@lamstack/react-core",
  "version": "0.1.0",
  "description": "Shared internal hooks used across lamstack React packages.",
  "keywords": [
    "react",
    "hooks",
    "headless",
    "lamstack"
  ],
  "license": "MIT",
  "author": "Ja Khang",
  "homepage": "https://lamstack-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakhang/lamstack.git",
    "directory": "packages/react-core"
  },
  "bugs": {
    "url": "https://github.com/jakhang/lamstack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@lamstack/react-dialog",
  "version": "0.1.1",
  "description": "Headless, imperative dialog API for React (alert/confirm/prompt + custom dialogs).",
  "keywords": [
    "react",
    "dialog",
    "modal",
    "headless",
    "toolpad",
    "lamstack"
  ],
  "license": "MIT",
  "author": "Ja Khang",
  "homepage": "https://lamstack-docs.vercel.app/dialog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakhang/lamstack.git",
    "directory": "packages/react-dialog"
  },
  "bugs": {
    "url": "https://github.com/jakhang/lamstack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lamstack/react-core": "workspace:*",
    "invariant": "^2.2.4"
  },
  "devDependencies": {
    "@types/invariant": "^2.2.37"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}

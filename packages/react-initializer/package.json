{
  "name": "@lamstack/react-initializer",
  "version": "0.3.0",
  "description": "Headless app-startup orchestrator for React — run async init steps (with parallel batching, abort, and retry) before rendering your app.",
  "keywords": [
    "react",
    "initializer",
    "bootstrap",
    "startup",
    "splash-screen",
    "headless",
    "lamstack"
  ],
  "license": "MIT",
  "author": "Ja Khang",
  "homepage": "https://omnireact-six.vercel.app/initializer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakhang/lamstack.git",
    "directory": "packages/react-initializer"
  },
  "bugs": {
    "url": "https://github.com/jakhang/lamstack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@lamstack/initializer": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
